<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Quête du Dragon » : le dragon à gauche, les quêtes du jour à droite. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/qd_widget_bg">

    <ImageView
        android:id="@+id/qd_dragon"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="Ton dragon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.25"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/qd_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F2D48A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/qd_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFB25A"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/qd_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A2988A"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/qd_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFF3DC"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/qd_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:progressTint="#F3A53A"
            android:progressBackgroundTint="#3A3342"
            android:max="1"
            android:progress="0" />

        <TextView
            android:id="@+id/qd_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#ECE4D4"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
